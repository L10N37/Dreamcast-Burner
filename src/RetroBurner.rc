#include <windows.h>
#include "resource.h"

IDI_APP_ICON ICON "../assets/RetroBurner.ico"
IDR_PNG_BURNING_DC RCDATA "../assets/BurningDC.png"
IDR_PNG_BURNING_PS1 RCDATA "../assets/BurningPS1.png"
IDR_PNG_BURNING_PS2 RCDATA "../assets/BurningPS2.png"
IDR_PNG_BURNING_SATURN RCDATA "../assets/BurningSaturn.png"
IDR_PNG_BURNING_XBOX360 RCDATA "../assets/BurningXB360.png"
IDR_PNG_SPINNING_DISC RCDATA "../assets/makeSpinDC.png"
1 RT_MANIFEST "../assets/app.manifest"


// Runtime tools are embedded so the distributable application is one EXE.
// At runtime Retro Burner extracts them into a private temporary directory.
IDR_BIN_CDIRIP RCDATA "../tools/.embedded/cdirip.exe"
IDR_BIN_CDRECORD RCDATA "../tools/cdrecord.exe"
IDR_BIN_CYGWIN RCDATA "../tools/cygwin1.dll"
IDR_BIN_GROWISOFS RCDATA "../tools/growisofs.exe"
IDR_BIN_DVD_MEDIAINFO RCDATA "../tools/dvd+rw-mediainfo.exe"
IDR_WAV_BURN_COMPLETE WAVE "../assets/mixkit-cartoon-monkey-mocking-laugh-107.wav"

// Keep third-party notices inside the single executable as resources.
// A later UI pass will expose these in an About / Licenses window.
IDR_LICENSE_THIRD_PARTY RCDATA "../THIRD_PARTY.md"
IDR_LICENSE_CDIRIP RCDATA "../external/cdirip/LICENSE"
IDR_LICENSE_CDRECORD_CDDL RCDATA "../licenses/cdrecord-cddl.txt"
IDR_LICENSE_CDRECORD_GPL RCDATA "../licenses/cdrecord-gpl3.txt"
IDR_LICENSE_CYGWIN RCDATA "../licenses/cygwin-GPL-2.0.txt"
IDR_LICENSE_IMGUI RCDATA "../external/imgui/LICENSE.txt"
